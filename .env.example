# Copy to .env (git-ignored). Variables already set in the environment win over this file.

# Telegram: create a bot with @BotFather, then send it a message and read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Email over SMTP with STARTTLS (Gmail: smtp.gmail.com, port 587, an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=replace-with-an-app-password
